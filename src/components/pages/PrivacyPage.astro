---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t, getLangFromUrl, localizedPath } from '../../i18n';


const lang = getLangFromUrl(Astro.url);
const i = t(lang);
const pr = i.privacyPage;
---
<BaseLayout title={i.meta.privacy.title} description={i.meta.privacy.description}>

  <!-- PAGE HERO -->
  <section class="pt-36 pb-10 bg-white text-center">
    <div class="max-w-6xl mx-auto px-5">
      <span class="section-label justify-center">{pr.hero.label}</span>
      <h1 class="section-title text-forest-dark">{pr.hero.title}</h1>
    </div>
    <div class="max-w-5xl mx-auto px-5 text-left">
        <p class="text-gray-600 mb-5">
            {pr.intro}
        </p>

        <div class="flex flex-col gap-8 text-left">
            {pr.groups.map((group) => (
                <div class="group">
                    <h2 class="text-2xl font-semibold mb-4">
                        {group.title}
                    </h2>
                    {group.list && (
                        <ul class="flex flex-col gap-3 px-5 list-disc">
                            {group.list.map((item) => (
                            <li class="text-gray-500">
                                {item}
                            </li>
                            ))}
                        </ul>
                    )}

                    {group.text && (
                        <p class="text-gray-600 mb-5">
                            {group.text}
                        </p>
                    )}
                </div>
            ))}
        </div>
    </div>
  </section>
</BaseLayout>